# Server
PORT=3000
NODE_ENV=development

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_processing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_processing

# Redis
REDIS_URL=redis://localhost:6379

# Workers
WORKER_COUNT=4
# Probability (0-1) that the mock job handler simulates a failure
MOCK_FAILURE_RATE=0.1
# Exponential backoff for retries: delay ceiling = base * 2^(attempt-1), capped at max
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
