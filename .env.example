# Server
PORT=3000
NODE_ENV=development

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_processing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_processing

# Redis
REDIS_URL=redis://localhost:6379
# Optional prefix for isolated deployments/tests; leave blank for normal use
QUEUE_NAMESPACE=

# Rate limiting for POST /jobs (token bucket per X-API-Key, or per IP without one)
# A client can burst up to RATE_LIMIT_BURST requests, then is held to
# RATE_LIMIT_REFILL_PER_SEC requests per second.
RATE_LIMIT_BURST=20
RATE_LIMIT_REFILL_PER_SEC=2

# Workers
WORKER_COUNT=4
# Probability (0-1) that the mock job handler simulates a failure
MOCK_FAILURE_RATE=0.1
# Exponential backoff for retries: delay ceiling = base * 2^(attempt-1), capped at max
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000

# Max time a single job attempt may run before the worker fails it as retryable
JOB_TIMEOUT_MS=60000

# Workers refresh a processing job's updated_at this often
HEARTBEAT_INTERVAL_MS=10000

# Reaper
# Jobs with no heartbeat for longer than this are treated as crashed and re-queued.
# Keep it at least 2-3x HEARTBEAT_INTERVAL_MS.
PROCESSING_TIMEOUT_MS=30000
REAPER_INTERVAL_MS=10000
